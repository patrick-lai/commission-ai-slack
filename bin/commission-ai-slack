#!/bin/sh
set -eu

self=$0
while [ -L "$self" ]; do
    target=$(readlink "$self")
    case "$target" in
        /*) self=$target ;;
        *) self=$(dirname -- "$self")/$target ;;
    esac
done
here=$(CDPATH='' cd -- "$(dirname -- "$self")/.." && pwd)

if ! command -v node >/dev/null 2>&1; then
    printf 'commission-ai-slack needs Node.js 20 or newer, and node was not found on PATH.\n' >&2
    exit 127
fi

exec node "$here/src/bin.js" "$@"
